/**
 * Configuração Rofi purista e abstrata alinhada com o estilo do wlogout.
 * Paleta: Preto (#000000), Cinzento Ultra-Escuro (#121212), Cinzento Médio (#444444), Cinzento Claro (#a0a0a0).
 */

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "//";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 16";
}

@theme "/dev/null"

* {
    bg: rgba(0, 0, 0, 0.75);
    element-bg: #121212;
    element-hover: #181818;
    fg-dim: #444444;
    fg-light: #a0a0a0;
    border-dim: #222222;

    background-color: transparent;
    text-color: @fg-dim;
}

window {
    fullscreen: true;
    background-color: @bg;
    width: 100%;
    height: 100%;
}

mainbox {
    children: [ inputbar, listview ];
    padding: 22% 32%;
}

inputbar {
    children: [ prompt, entry ];
    margin: 0 0 40px 0;
    padding: 12px 20px;
    background-color: #121212;
    border: 0px 0px 0px 2px;
    border-color: @border-dim;
}

prompt {
    text-color: @fg-light;
    padding: 0 15px 0 0;
    font: "JetBrainsMono Nerd Font Medium 16";
}

entry {
    placeholder: "pesquisar...";
    placeholder-color: #333333;
    text-color: @fg-light;
    font: "JetBrainsMono Nerd Font 16";
}

listview {
    lines: 6;
    columns: 1;
    fixed-height: false;
    spacing: 12px;
}

element {
    padding: 16px 20px;
    cursor: pointer;
    background-color: @element-bg;
    text-color: @fg-dim;
    border: 0px 0px 0px 2px;
    border-color: @border-dim;
}

element selected {
    background-color: @element-hover;
    text-color: @fg-light;
    border: 0px 0px 0px 2px;
    border-color: @fg-light;
}

element-icon {
    size: 28px;
    padding: 0 20px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 16";
}

element-text selected {
    text-color: @fg-light;
    font: "JetBrainsMono Nerd Font 16";
}
