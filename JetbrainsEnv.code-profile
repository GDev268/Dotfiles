idden\\\",\\n    \\\"editor.scrollbar.horizontal\\\": \\\"hidden\\\",\\n    \\\"workbench.activityBar.compact\\\": true,\\n    \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n    \\\"go.useLanguageServer\\\": true,\\n    \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false,\\n    \\\"editor.acceptSuggestionOnEnter\\\": \\\"on\\\",\\n\\\"custom-ui-style.stylesheet\\\": {\\n\\n\\\".monaco-workbench\\\": \\\"background-color: #1e1f22 !important;\\\",\\n\\n/* Regra das margens/bordas separada para isolar a sidebar */\\n\\n\\\".monaco-workbench .part.auxiliarybar, .monaco-workbench .part.editor, .monaco-workbench .part.panel\\\": \\\"border-radius: 10px !important; margin: 4px !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;\\\",\\n\\n/* Sidebar corrigida: em vez de margin, usa-se box-sizing e contorno limpo para evitar desalinhar a árvore */\\n\\n\\\".monaco-workbench .part.sidebar\\\": \\\"border-radius: 10px !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; box-sizing: border-box !important;\\\",\\n\\n\\\".monaco-workbench .part.sidebar .content\\\": \\\"padding: 4px !important;\\\",\\n\\n\\\".monaco-workbench .part.titlebar\\\": \\\"border-radius: 0 !important; margin: 0 !important; border: none !important; background-color: #1e1f22 !important;\\\",\\n\\n\\\".monaco-workbench .part.activitybar\\\": \\\"border-radius: 0 !important; margin: 0 !important; border: none !important; background-color: #1e1f22 !important; box-shadow: none !important;\\\",\\n\\n\\\".monaco-workbench .part.editor > .content\\\": \\\"border-radius: 8px !important; overflow: hidden !important;\\\",\\n\\n\\\".tabs-and-actions-container\\\": \\\"border-bottom: none !important;\\\",\\n\\n\\\".tabs-container .tab\\\": \\\"border-radius: 6px 6px 0 0 !important; margin-right: 2px !important; border: none !important; box-shadow: none !important;\\\",\\n\\n\\\".monaco-workbench .part.panel\\\": \\\"margin: 0 4px 4px 4px !important;\\\",\\n\\n\\\".mona